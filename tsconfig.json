{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/registry/*": [
        "registry/*"
      ],
      "@agatx/serenada-core": [
        "vendor/serenada-core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "registry",
    "vendor/serenada-core/src",
    "vendor/serenada-react-ui/src",
    "tests",
    "vite.config.ts",
    "vendor/peerix-picker"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "vendor/**/test"
  ]
}